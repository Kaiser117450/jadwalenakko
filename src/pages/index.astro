---
import { buildPublicStatusViewModel } from "../lib/public-status/view-model";

const initialViewModel = buildPublicStatusViewModel(null, "loading");
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Status Operasional Realtime | Ayam Guling Enakko</title>
    <meta
      name="description"
      content="Papan status operasional realtime Ayam Guling Enakko dengan pembaruan live dari database."
    />
    <style is:global>
      @import "tailwindcss";

      @font-face {
        font-family: "Digitalt";
        src: url("/Digitalt.ttf") format("truetype");
        font-display: swap;
      }

      :root {
        --bg: #ffe4d6;
        --red: #ff0000;
        --mustard: #ffc300;
        --deep: #7a1200;
        --soft: #8a2a08;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--deep);
        font-family: "Aptos", "Segoe UI", "Trebuchet MS", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(255, 195, 0, 0.34), transparent 24%),
          radial-gradient(circle at top right, rgba(255, 0, 0, 0.12), transparent 28%),
          linear-gradient(180deg, #fff5ef 0%, #ffe7da 38%, #ffdccc 100%);
      }

      h1,
      h2,
      h3,
      .display-font {
        font-family: "Digitalt", "Arial Narrow", sans-serif;
        letter-spacing: 0.04em;
      }

      [data-status-tone="normal"] {
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.1);
      }

      [data-status-tone="limited"] {
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.1);
      }

      [data-status-tone="halfday"] {
        border-color: rgba(255, 195, 0, 0.45);
        background: rgba(255, 195, 0, 0.16);
      }

      [data-status-tone="closed"] {
        border-color: rgba(255, 255, 255, 0.05);
        background: #ff0000;
      }

      [data-status-tone="unavailable"] {
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.08);
      }
    </style>
  </head>
  <body class="antialiased selection:bg-[#ffc300] selection:text-[#7a1200]">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(122,18,0,0.06)_1px,transparent_0)] bg-[length:22px_22px]"></div>
      <div class="absolute -left-16 top-8 h-56 w-56 rounded-full bg-[#ffc300]/40 blur-3xl"></div>
      <div class="absolute right-[-5rem] top-24 h-72 w-72 rounded-full bg-[#ff0000]/15 blur-3xl"></div>
    </div>

    <main class="relative mx-auto min-h-screen max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <section class="space-y-8 pb-10 sm:space-y-10">
        <section class="rounded-[2.6rem] border border-white/70 bg-white/45 p-5 shadow-[0_28px_90px_rgba(168,62,0,0.12)] backdrop-blur-md sm:p-7 lg:p-10">
          <div class="mx-auto max-w-4xl text-center">
            <img src="/logo.png" alt="Ayam Guling Enakko Logo" class="mx-auto mb-4 h-20" />
            <span class="inline-flex rounded-full border border-[#ff0000]/10 bg-white/85 px-4 py-1 text-[11px] font-black uppercase tracking-[0.32em] text-[#a12e00]">
              Live Status Board
            </span>
            <h1 class="display-font mt-5 text-[2.7rem] font-black leading-[0.95] text-[#ff0000] sm:text-[4.4rem]">
              Status Operasional Ayam Guling Enakko
            </h1>
            <p class="mx-auto mt-5 max-w-3xl text-sm leading-7 text-[#8a2a08] sm:text-base sm:leading-8">
              Halaman ini membaca status operasional realtime dari SpacetimeDB. Banner utama dan daftar gerai
              selalu mengikuti status live yang sedang aktif tanpa perlu edit source atau rebuild manual.
            </p>
          </div>

          <div class="mt-8 grid gap-5 lg:grid-cols-[1.15fr_0.85fr] lg:gap-6">
            <section class="rounded-[2.2rem] bg-[linear-gradient(135deg,#7a1200_0%,#551000_100%)] p-6 text-white shadow-[0_24px_80px_rgba(122,18,0,0.28)] sm:p-7">
              <p class="text-xs font-black uppercase tracking-[0.3em] text-white/70">Status Real-Time</p>
              <p id="current-date-label" class="mt-2 text-sm font-semibold text-white/90">
                Memuat tanggal perangkat...
              </p>
              <div
                id="status-shell"
                data-public-state={initialViewModel.presentationState}
                data-status-tone={initialViewModel.statusTone}
                aria-live="polite"
                class="mt-6 rounded-[1.9rem] border p-5 backdrop-blur-sm sm:p-6"
              >
                <div class="flex items-start gap-4">
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#ffc300] text-[#7a1200] shadow-[0_12px_28px_rgba(255,195,0,0.28)]">
                    <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
                      <path d="M12 2 2 20h20L12 2Zm0 5.2 6.14 10.8H5.86L12 7.2Zm-1.1 3.3v4.2h2.2v-4.2h-2.2Zm0 5.3V18h2.2v-2.2h-2.2Z" />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p
                      data-public-status-label
                      class="text-xs font-black uppercase tracking-[0.28em] text-white/65"
                    >
                      {initialViewModel.statusLabel}
                    </p>
                    <h2
                      data-public-headline
                      class="display-font mt-3 text-[2rem] font-black leading-tight text-white sm:text-[2.4rem]"
                    >
                      {initialViewModel.headline}
                    </h2>
                    <p data-public-status-banner class="mt-3 text-sm leading-7 text-white/88 sm:text-base">
                      {initialViewModel.banner}
                    </p>
                  </div>
                </div>

                <div class="mt-5 flex flex-wrap items-center gap-3">
                  <span
                    data-public-fallback-chip
                    class="hidden rounded-full border border-white/12 bg-white/12 px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em] text-white"
                  >
                    Operasional Normal
                  </span>
                  <span data-public-connection-note class="text-xs font-semibold tracking-[0.08em] text-white/72">
                    Menunggu status dari database realtime.
                  </span>
                </div>
              </div>
            </section>

            <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
              <div class="rounded-[1.8rem] border border-white/70 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <p data-public-normal-count class="text-3xl font-black text-[#ff0000]">
                  {initialViewModel.normalBranchCount}
                </p>
                <p class="mt-1 text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Normal</p>
              </div>
              <div class="rounded-[1.8rem] border border-white/70 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <p data-public-limited-count class="text-3xl font-black text-[#7a1200]">
                  {initialViewModel.limitedBranchCount}
                </p>
                <p class="mt-1 text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">
                  Terbatas / Halfday
                </p>
              </div>
              <div class="rounded-[1.8rem] border border-white/70 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <p data-public-closed-count class="text-3xl font-black text-[#7a1200]">
                  {initialViewModel.closedBranchCount}
                </p>
                <p class="mt-1 text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Tutup</p>
              </div>
            </div>
          </div>
        </section>

        <section class="grid gap-5 lg:grid-cols-[0.78fr_1.22fr] lg:gap-6">
          <div class="rounded-[2.1rem] border border-white/70 bg-white/55 p-6 shadow-[0_20px_60px_rgba(173,62,0,0.10)] backdrop-blur-md">
            <p class="text-xs font-black uppercase tracking-[0.32em] text-[#a12e00]">Panduan Status</p>
            <h2 class="display-font mt-4 text-[1.9rem] font-black leading-tight text-[#7a1200]">
              Cepat Dibaca, Cepat Diputuskan
            </h2>
            <div class="mt-6 space-y-4">
              <div class="rounded-[1.5rem] border border-[#ff0000]/10 bg-white/85 p-5">
                <span class="inline-flex rounded-full bg-[#7a1200] px-3 py-1 text-[11px] font-black uppercase tracking-[0.24em] text-white">
                  Normal
                </span>
                <p class="mt-4 text-sm leading-7 text-[#8a2a08]">
                  Status live tetap menegaskan kondisi normal, jadi pengunjung tidak perlu menebak apakah data sedang kosong atau semua gerai memang aktif.
                </p>
              </div>
              <div class="rounded-[1.5rem] border border-[#ffc300]/40 bg-[#fff5dc] p-5">
                <span class="inline-flex rounded-full bg-[#ffc300] px-3 py-1 text-[11px] font-black uppercase tracking-[0.24em] text-[#7a1200]">
                  Terbatas / Setengah Hari
                </span>
                <p class="mt-4 text-sm leading-7 text-[#8a2a08]">
                  Cabang normal, terbatas, dan tutup dipisah ke tiga grup agar perubahan operasional bisa dibaca dalam sekali lihat.
                </p>
              </div>
              <div class="rounded-[1.5rem] border border-[#ff0000] bg-[linear-gradient(135deg,#ff0000_0%,#c60000_100%)] p-5 text-white">
                <span class="inline-flex rounded-full bg-white px-3 py-1 text-[11px] font-black uppercase tracking-[0.24em] text-[#ff0000]">
                  Tidak Tersedia
                </span>
                <p class="mt-4 text-sm leading-7 text-white/85">
                  Saat koneksi live belum tersedia, halaman menunjukkan kondisi unavailable secara eksplisit daripada meninggalkan panel kosong.
                </p>
              </div>
            </div>
          </div>

          <section class="rounded-[2.1rem] border border-white/70 bg-white/55 p-6 shadow-[0_20px_60px_rgba(173,62,0,0.10)] backdrop-blur-md">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.32em] text-[#a12e00]">Gerai Terdampak</p>
                <h2 class="display-font mt-3 text-[2rem] font-black leading-tight text-[#7a1200]">
                  Status Cabang Saat Ini
                </h2>
              </div>
              <p class="max-w-sm text-sm leading-7 text-[#8a2a08]">
                Daftar ini mengikuti payload `publicCurrentStatus`, jadi UI tidak lagi membangun ulang aturan status dari jadwal statis.
              </p>
            </div>

            <div class="mt-6 grid gap-5 xl:grid-cols-3">
              <article class="rounded-[1.8rem] border border-[#ff0000]/10 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Gerai Normal</p>
                    <p data-public-normal-summary class="mt-2 text-sm leading-7 text-[#8a2a08]">
                      Menyiapkan cabang yang berjalan normal dari status live.
                    </p>
                  </div>
                  <span
                    class="rounded-full bg-[#7a1200] px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em] text-white"
                  >
                    Stabil
                  </span>
                </div>
                <ul data-public-normal-branches class="mt-5 flex flex-wrap gap-2.5">
                  <li class="rounded-full border border-[#ff0000]/10 bg-[#fff7f1] px-3 py-1 text-xs font-bold text-[#7a1200]">
                    Memuat status operasional...
                  </li>
                </ul>
              </article>

              <article class="rounded-[1.8rem] border border-[#ff0000]/10 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">
                      Gerai Terbatas / Halfday
                    </p>
                    <p data-public-limited-summary class="mt-2 text-sm leading-7 text-[#8a2a08]">
                      Panel ini akan menunjukkan cabang dengan jam terbatas atau setengah hari.
                    </p>
                  </div>
                  <span
                    class="rounded-full bg-[#ffc300] px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em] text-[#7a1200]"
                  >
                    Terbatas
                  </span>
                </div>
                <ul data-public-limited-branches class="mt-5 flex flex-wrap gap-2.5">
                  <li class="rounded-full border border-[#ffc300]/40 bg-[#fff5dc] px-3 py-1 text-xs font-bold text-[#7a1200]">
                    Memuat status operasional...
                  </li>
                </ul>
              </article>

              <article class="rounded-[1.8rem] border border-[#ff0000]/10 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Gerai Tutup</p>
                    <p data-public-closed-summary class="mt-2 text-sm leading-7 text-[#8a2a08]">
                      Panel ini akan menunjukkan cabang yang sedang tidak aktif.
                    </p>
                  </div>
                  <span
                    class="rounded-full border border-[#7a1200]/10 bg-white px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em] text-[#a12e00]"
                  >
                    Sinkron
                  </span>
                </div>
                <ul data-public-closed-branches class="mt-5 flex flex-wrap gap-2.5">
                  <li class="rounded-full border border-[#7a1200]/10 bg-white px-3 py-1 text-xs font-bold text-[#8a2a08]">
                    Memuat status operasional...
                  </li>
                </ul>
              </article>
            </div>
          </section>
        </section>
      </section>
    </main>

    <script>
      import { disconnectPublicStatusClient, subscribePublicCurrentStatus } from "../lib/spacetimedb/public-status-client";
      import { buildPublicStatusViewModel } from "../lib/public-status/view-model";

      const currentDateLabel = document.getElementById("current-date-label");
      const statusShell = document.getElementById("status-shell");
      const statusLabel = document.querySelector("[data-public-status-label]");
      const statusHeadline = document.querySelector("[data-public-headline]");
      const statusBanner = document.querySelector("[data-public-status-banner]");
      const fallbackChip = document.querySelector("[data-public-fallback-chip]");
      const connectionNote = document.querySelector("[data-public-connection-note]");
      const normalCount = document.querySelector("[data-public-normal-count]");
      const limitedCount = document.querySelector("[data-public-limited-count]");
      const closedCount = document.querySelector("[data-public-closed-count]");
      const normalSummary = document.querySelector("[data-public-normal-summary]");
      const limitedSummary = document.querySelector("[data-public-limited-summary]");
      const closedSummary = document.querySelector("[data-public-closed-summary]");
      const normalBranchesList = document.querySelector("[data-public-normal-branches]");
      const limitedBranchesList = document.querySelector("[data-public-limited-branches]");
      const closedBranchesList = document.querySelector("[data-public-closed-branches]");

      const connectionNotes = {
        loading: "Menghubungkan halaman dengan database realtime.",
        "ready-normal": "Status live aktif dan semua gerai sedang berjalan normal.",
        "ready-special": "Status live aktif dan pembatasan cabang sedang diterapkan.",
        unavailable: "Koneksi live belum tersedia. Coba muat ulang dalam beberapa saat.",
      };

      const renderBranchList = (element, branches, emptyText, accent) => {
        if (!element) {
          return;
        }

        element.replaceChildren();

        if (branches.length === 0) {
          const emptyItem = document.createElement("li");
          emptyItem.className =
            accent === "normal"
              ? "rounded-full border border-[#ff0000]/10 bg-[#fff7f1] px-3 py-1 text-xs font-bold text-[#7a1200]"
              : accent === "limited"
                ? "rounded-full border border-[#ffc300]/40 bg-[#fff5dc] px-3 py-1 text-xs font-bold text-[#7a1200]"
              : "rounded-full border border-[#7a1200]/10 bg-white px-3 py-1 text-xs font-bold text-[#8a2a08]";
          emptyItem.textContent = emptyText;
          element.append(emptyItem);
          return;
        }

        branches.forEach((branch) => {
          const item = document.createElement("li");
          item.className =
            accent === "normal"
              ? "rounded-full border border-[#ff0000]/10 bg-[#fff7f1] px-3 py-1 text-xs font-bold text-[#7a1200]"
              : accent === "limited"
                ? "rounded-full border border-[#ffc300]/40 bg-[#fff5dc] px-3 py-1 text-xs font-bold text-[#7a1200]"
              : "rounded-full border border-[#7a1200]/10 bg-white px-3 py-1 text-xs font-bold text-[#8a2a08]";

          const branchTags = [];

          if (branch.statusKind === "limited") {
            branchTags.push("terbatas");
          }

          if (branch.statusKind === "halfday") {
            branchTags.push("setengah hari");
          }

          if (branch.isTargeted) {
            branchTags.push("target");
          }

          item.textContent = branchTags.length > 0 ? `${branch.name} · ${branchTags.join(" · ")}` : branch.name;

          element.append(item);
        });
      };

      const getNormalSummary = (model) => {
        if (model.presentationState === "loading") {
          return "Memuat daftar cabang normal dari status realtime.";
        }

        if (model.presentationState === "unavailable") {
          return "Status operasional belum tersedia.";
        }

        if (model.isNormalFallback) {
          return "Semua cabang aktif mengikuti operasional reguler.";
        }

        if (model.normalBranchCount === 0) {
          return "Tidak ada cabang yang berjalan normal pada status aktif ini.";
        }

        return `${model.normalBranchCount} cabang tetap berjalan normal pada status aktif ini.`;
      };

      const getLimitedSummary = (model) => {
        if (model.presentationState === "loading") {
          return "Memuat cabang dengan jam terbatas atau setengah hari.";
        }

        if (model.presentationState === "unavailable") {
          return "Status operasional belum tersedia.";
        }

        if (model.limitedBranchCount === 0) {
          return model.isNormalFallback
            ? "Tidak ada cabang dengan jam terbatas pada kondisi normal."
            : "Tidak ada cabang dengan jam terbatas atau setengah hari pada status aktif ini.";
        }

        return `${model.limitedBranchCount} cabang sedang terbatas atau setengah hari.`;
      };

      const getClosedSummary = (model) => {
        if (model.presentationState === "loading") {
          return "Menunggu daftar gerai yang sedang tidak aktif.";
        }

        if (model.presentationState === "unavailable") {
          return "Status operasional belum tersedia.";
        }

        if (model.isNormalFallback && model.closedBranchCount === 0) {
          return "Tidak ada gerai yang tutup pada kondisi normal ini.";
        }

        return `${model.closedBranchCount} gerai sedang tidak aktif pada status saat ini.`;
      };

      const render = (model) => {
        if (!statusShell || !statusLabel || !statusHeadline || !statusBanner || !connectionNote) {
          return;
        }

        statusShell.dataset.publicState = model.presentationState;
        statusShell.dataset.statusTone = model.statusTone;
        statusLabel.textContent = model.statusLabel;
        statusHeadline.textContent = model.headline;
        statusBanner.textContent = model.banner;
        connectionNote.textContent = connectionNotes[model.presentationState];

        if (normalCount) {
          normalCount.textContent = String(model.normalBranchCount);
        }

        if (limitedCount) {
          limitedCount.textContent = String(model.limitedBranchCount);
        }

        if (closedCount) {
          closedCount.textContent = String(model.closedBranchCount);
        }

        if (normalSummary) {
          normalSummary.textContent = getNormalSummary(model);
        }

        if (limitedSummary) {
          limitedSummary.textContent = getLimitedSummary(model);
        }

        if (closedSummary) {
          closedSummary.textContent = getClosedSummary(model);
        }

        const isFallbackNormal = model.isNormalFallback;

        if (fallbackChip) {
          fallbackChip.classList.toggle("hidden", !isFallbackNormal);
          fallbackChip.textContent = isFallbackNormal ? "Operasional Normal" : "";
        }

        renderBranchList(
          normalBranchesList,
          model.normalBranches,
          model.presentationState === "unavailable"
            ? "Status operasional belum tersedia."
            : "Memuat status operasional...",
          "normal",
        );

        renderBranchList(
          limitedBranchesList,
          model.limitedBranches,
          model.presentationState === "loading"
            ? "Memuat status operasional..."
            : "Tidak ada cabang terbatas atau halfday pada status saat ini.",
          "limited",
        );

        renderBranchList(
          closedBranchesList,
          model.closedBranches,
          model.presentationState === "loading"
            ? "Memuat status operasional..."
            : isFallbackNormal
              ? "Tidak ada. Semua gerai beroperasi normal."
              : "Status operasional belum tersedia.",
          "closed",
        );
      };

      const updateCurrentDateLabel = () => {
        if (!currentDateLabel) {
          return;
        }

        currentDateLabel.textContent = new Intl.DateTimeFormat("id-ID", {
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        }).format(new Date());
      };

      let hasResolvedPayload = false;
      const loadingViewModel = buildPublicStatusViewModel(null, "loading");
      const unavailableTimer = window.setTimeout(() => {
        if (!hasResolvedPayload) {
          render(buildPublicStatusViewModel(null, "unavailable"));
        }
      }, 3000);

      updateCurrentDateLabel();
      render(loadingViewModel);

      const unsubscribe = subscribePublicCurrentStatus((payload) => {
        if (payload) {
          hasResolvedPayload = true;
          window.clearTimeout(unavailableTimer);
          render(buildPublicStatusViewModel(payload, "ready"));
          updateCurrentDateLabel();
          return;
        }

        if (hasResolvedPayload) {
          render(buildPublicStatusViewModel(null, "unavailable"));
        }
      });

      window.addEventListener(
        "pagehide",
        () => {
          window.clearTimeout(unavailableTimer);
          unsubscribe();
          disconnectPublicStatusClient();
        },
        { once: true },
      );
    </script>
  </body>
</html>
