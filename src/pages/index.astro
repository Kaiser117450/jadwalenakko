---
const allBranches = [
  "Panjer",
  "Ahmad Yani",
  "Monang Maning",
  "Tukad Pakerisan",
  "Dalung 1",
  "Pulau Kawe",
  "Kuta",
  "Tangkuban Perahu",
  "Pemogan",
  "Mengwi",
  "Dalung 2",
  "Kreneng",
];

const limitedOpenBranches = [
  "Panjer",
  "Ahmad Yani",
  "Monang Maning",
  "Tukad Pakerisan",
  "Dalung 1",
  "Pulau Kawe",
  "Kuta",
];

const limitedClosedBranches = [
  "Tangkuban Perahu",
  "Pemogan",
  "Mengwi",
  "Dalung 2",
  "Kreneng",
];

const schedule = [
  {
    date: "2026-03-16",
    displayDate: "16 Maret 2026",
    label: "Operasional Normal",
    type: "normal",
    hours: "Jam reguler",
    title: "Semua Gerai Buka Normal",
    bannerMessage: "Semua gerai buka normal sesuai jam operasional reguler.",
    note: "Layanan makan di tempat, take away, dan delivery berjalan seperti biasa.",
    openBranches: allBranches,
    closedBranches: [],
  },
  {
    date: "2026-03-17",
    displayDate: "17 Maret 2026",
    label: "Crew Mudik",
    type: "limited",
    hours: "Jam reguler gerai aktif",
    title: "Sebagian Gerai Tetap Buka",
    bannerMessage:
      "Crew Mudik. Gerai Panjer, Ahmad Yani, Monang Maning, Tukad Pakerisan, Dalung 1, Pulau Kawe, dan Kuta tetap buka.",
    note: "Operasional difokuskan pada gerai utama yang tetap melayani selama masa mudik.",
    openBranches: limitedOpenBranches,
    closedBranches: limitedClosedBranches,
  },
  {
    date: "2026-03-18",
    displayDate: "18 Maret 2026",
    label: "Pengerupukan",
    type: "halfday",
    hours: "09.00 - 16.00",
    title: "Buka 1/2 Hari",
    bannerMessage:
      "Buka setengah hari pukul 09.00 - 16.00. Gerai tertentu tutup selama Pengerupukan.",
    note: "Jam layanan dipercepat untuk persiapan menjelang Hari Raya Nyepi.",
    openBranches: limitedOpenBranches,
    closedBranches: limitedClosedBranches,
  },
  {
    date: "2026-03-19",
    displayDate: "19 Maret 2026",
    label: "Nyepi",
    type: "closed",
    hours: "Tutup total",
    title: "SEMUA GERAI AGE BALI TUTUP TOTAL",
    bannerMessage: "NYEPI. Seluruh gerai tutup total.",
    note: "Tidak ada operasional di seluruh gerai Ayam Guling Enakko area Bali.",
    openBranches: [],
    closedBranches: allBranches,
  },
  {
    date: "2026-03-20",
    displayDate: "20 Maret 2026",
    label: "Cuti / Lebaran",
    type: "limited",
    hours: "Jam reguler gerai aktif",
    title: "Gerai Terpilih Tetap Buka",
    bannerMessage: "Cuti Lebaran. Gerai terpilih tetap buka, sebagian gerai lainnya tutup.",
    note: "Operasional terbatas masih mengikuti pola gerai aktif selama cuti bersama.",
    openBranches: limitedOpenBranches,
    closedBranches: limitedClosedBranches,
  },
  {
    date: "2026-03-21",
    displayDate: "21 Maret 2026",
    label: "Idul Fitri",
    type: "lebaran",
    hours: "13.00 - 22.00",
    title: "Buka 1/2 Hari",
    bannerMessage:
      "LEBARAN. Buka setengah hari pukul 13.00 - 22.00. Gerai tertentu tutup.",
    note: "Jam operasional khusus Idul Fitri berlaku untuk gerai yang tetap melayani.",
    openBranches: limitedOpenBranches,
    closedBranches: limitedClosedBranches,
  },
  {
    date: "2026-03-22",
    displayDate: "22 Maret 2026",
    label: "Cuti / Lebaran",
    type: "limited",
    hours: "Jam reguler gerai aktif",
    title: "Gerai Terpilih Tetap Buka",
    bannerMessage: "Cuti Lebaran. Gerai terpilih tetap buka, sebagian gerai lainnya tutup.",
    note: "Operasional terbatas masih mengikuti pola gerai aktif selama cuti bersama.",
    openBranches: limitedOpenBranches,
    closedBranches: limitedClosedBranches,
  },
  {
    date: "2026-03-23",
    displayDate: "23 Maret 2026",
    label: "Cuti / Lebaran",
    type: "limited",
    hours: "Jam reguler gerai aktif",
    title: "Gerai Terpilih Tetap Buka",
    bannerMessage: "Cuti Lebaran. Gerai terpilih tetap buka, sebagian gerai lainnya tutup.",
    note: "Operasional terbatas masih mengikuti pola gerai aktif selama cuti bersama.",
    openBranches: limitedOpenBranches,
    closedBranches: limitedClosedBranches,
  },
  {
    date: "2026-03-24",
    displayDate: "24 Maret 2026",
    label: "Cuti / Lebaran",
    type: "limited",
    hours: "Jam reguler gerai aktif",
    title: "Gerai Terpilih Tetap Buka",
    bannerMessage: "Cuti Lebaran. Gerai terpilih tetap buka, sebagian gerai lainnya tutup.",
    note: "Operasional terbatas masih mengikuti pola gerai aktif selama cuti bersama.",
    openBranches: limitedOpenBranches,
    closedBranches: limitedClosedBranches,
  },
  {
    date: "2026-03-25",
    displayDate: "25 Maret 2026",
    label: "Operasional Normal",
    type: "normal",
    hours: "Jam reguler",
    title: "Semua Gerai Buka Normal",
    bannerMessage: "Semua gerai buka normal kembali sesuai jam operasional reguler.",
    note: "Operasional Ayam Guling Enakko kembali berjalan penuh di semua gerai.",
    openBranches: allBranches,
    closedBranches: [],
  },
].map((item) => ({
  ...item,
  dayNumber: item.date.slice(-2),
  openCount: item.openBranches.length,
  closedCount: item.closedBranches.length,
}));
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jadwal Operasional Nyepi & Lebaran 2026 | Ayam Guling Enakko</title>
    <meta
      name="description"
      content="Papan pengumuman operasional Ayam Guling Enakko untuk periode Nyepi dan Lebaran 2026."
    />
    <style is:global>
      @import "tailwindcss";

      @font-face {
        font-family: "Digitalt";
        src: url("/Digitalt.ttf") format("truetype");
        font-display: swap;
      }

      :root {
        --bg: #ffe4d6;
        --red: #ff0000;
        --mustard: #ffc300;
        --deep: #7a1200;
        --soft: #8a2a08;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--deep);
        font-family: "Aptos", "Segoe UI", "Trebuchet MS", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(255, 195, 0, 0.34), transparent 24%),
          radial-gradient(circle at top right, rgba(255, 0, 0, 0.12), transparent 28%),
          linear-gradient(180deg, #fff5ef 0%, #ffe7da 38%, #ffdccc 100%);
      }

      h1,
      h2,
      h3,
      .display-font {
        font-family: "Digitalt", "Arial Narrow", sans-serif;
        letter-spacing: 0.04em;
      }

      @keyframes rise-in {
        from {
          opacity: 0;
          transform: translateY(20px) scale(0.985);
        }

        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .rise-card {
        opacity: 0;
        animation: rise-in 0.65s cubic-bezier(0.2, 0.9, 0.2, 1) forwards;
      }
    </style>
  </head>
  <body class="antialiased selection:bg-[#ffc300] selection:text-[#7a1200]">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(122,18,0,0.06)_1px,transparent_0)] bg-[length:22px_22px]"></div>
      <div class="absolute -left-16 top-8 h-56 w-56 rounded-full bg-[#ffc300]/40 blur-3xl"></div>
      <div class="absolute right-[-5rem] top-24 h-72 w-72 rounded-full bg-[#ff0000]/15 blur-3xl"></div>
    </div>

    <main class="relative mx-auto min-h-screen max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <section id="schedule-content" class="space-y-8 pb-10 sm:space-y-10">
        <section class="rounded-[2.6rem] border border-white/70 bg-white/45 p-5 shadow-[0_28px_90px_rgba(168,62,0,0.12)] backdrop-blur-md sm:p-7 lg:p-10">
          <div class="mx-auto max-w-4xl text-center">
            <img src="/logo.png" alt="Ayam Guling Enakko Logo" class="mx-auto h-20 mb-4" />
            <span class="inline-flex rounded-full border border-[#ff0000]/10 bg-white/85 px-4 py-1 text-[11px] font-black uppercase tracking-[0.32em] text-[#a12e00]">
              Official Schedule
            </span>
            <h1 class="display-font mt-5 text-[2.7rem] font-black leading-[0.95] text-[#ff0000] sm:text-[4.4rem]">
              Jadwal Operasional Nyepi & Lebaran 2026
            </h1>
            <p class="mx-auto mt-5 max-w-3xl text-sm leading-7 text-[#8a2a08] sm:text-base sm:leading-8">
              Informasi ini mengikuti tanggal browser pengunjung. Banner hari ini dan kartu jadwal yang relevan
              akan berubah otomatis sesuai periode operasional Ayam Guling Enakko area Bali.
            </p>
          </div>

          <div class="mt-8 grid gap-5 lg:grid-cols-[1.15fr_0.85fr] lg:gap-6">
            <div class="rounded-[2.2rem] bg-[linear-gradient(135deg,#7a1200_0%,#551000_100%)] p-6 text-white shadow-[0_24px_80px_rgba(122,18,0,0.28)] sm:p-7">
              <p class="text-xs font-black uppercase tracking-[0.3em] text-white/70">Status Real-Time</p>
              <p id="current-date-label" class="mt-2 text-sm font-semibold text-white/90">
                Memuat tanggal perangkat...
              </p>
              <div
                id="status-shell"
                class="mt-6 rounded-[1.9rem] border border-white/12 bg-white/10 p-5 backdrop-blur-sm sm:p-6"
              >
                <div class="flex items-start gap-4">
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#ffc300] text-[#7a1200] shadow-[0_12px_28px_rgba(255,195,0,0.28)]">
                    <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
                      <path d="M12 2 2 20h20L12 2Zm0 5.2 6.14 10.8H5.86L12 7.2Zm-1.1 3.3v4.2h2.2v-4.2h-2.2Zm0 5.3V18h2.2v-2.2h-2.2Z" />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-black uppercase tracking-[0.28em] text-white/65">Hari Ini</p>
                    <p id="status-banner" class="mt-3 text-lg font-black leading-8 text-white sm:text-xl">
                      Menyiapkan status operasional hari ini...
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
              <div class="rounded-[1.8rem] border border-white/70 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <p class="text-3xl font-black text-[#ff0000]">12</p>
                <p class="mt-1 text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Total Gerai</p>
              </div>
              <div class="rounded-[1.8rem] border border-white/70 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <p class="text-3xl font-black text-[#7a1200]">16-25</p>
                <p class="mt-1 text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Maret 2026</p>
              </div>
              <div class="rounded-[1.8rem] border border-white/70 bg-white/80 p-5 shadow-[0_18px_50px_rgba(173,62,0,0.08)]">
                <p class="text-sm font-black uppercase tracking-[0.24em] text-[#a12e00]">Sorotan</p>
                <p class="mt-3 text-sm leading-7 text-[#7a1200]">18 Mar setengah hari, 19 Mar tutup total, 21 Mar buka 13.00-22.00.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="grid gap-5 lg:grid-cols-[0.78fr_1.22fr] lg:gap-6">
          <div class="rounded-[2.1rem] border border-white/70 bg-white/55 p-6 shadow-[0_20px_60px_rgba(173,62,0,0.10)] backdrop-blur-md">
            <p class="text-xs font-black uppercase tracking-[0.32em] text-[#a12e00]">Panduan Warna</p>
            <h2 class="display-font mt-4 text-[1.9rem] font-black leading-tight text-[#7a1200]">Cepat Dibaca, Cepat Diputuskan</h2>
            <div class="mt-6 space-y-4">
              <div class="rounded-[1.5rem] border border-[#ff0000]/10 bg-white/85 p-5">
                <span class="inline-flex rounded-full bg-[#7a1200] px-3 py-1 text-[11px] font-black uppercase tracking-[0.24em] text-white">Normal / Terbatas</span>
                <p class="mt-4 text-sm leading-7 text-[#8a2a08]">Kartu terang untuk operasional reguler atau sebagian gerai aktif.</p>
              </div>
              <div class="rounded-[1.5rem] border border-[#ffc300]/40 bg-[#fff5dc] p-5">
                <span class="inline-flex rounded-full bg-[#ffc300] px-3 py-1 text-[11px] font-black uppercase tracking-[0.24em] text-[#7a1200]">Setengah Hari</span>
                <p class="mt-4 text-sm leading-7 text-[#8a2a08]">Dipakai pada Pengerupukan dan Idul Fitri dengan jam khusus.</p>
              </div>
              <div class="rounded-[1.5rem] border border-[#ff0000] bg-[linear-gradient(135deg,#ff0000_0%,#cc0000_100%)] p-5 text-white">
                <span class="inline-flex rounded-full bg-white px-3 py-1 text-[11px] font-black uppercase tracking-[0.24em] text-[#ff0000]">Tutup Total</span>
                <p class="mt-4 text-sm leading-7 text-white/85">Nyepi ditampilkan merah solid agar langsung menonjol di layar.</p>
              </div>
            </div>
          </div>

          <div class="rounded-[2.1rem] border border-white/70 bg-white/55 p-6 shadow-[0_20px_60px_rgba(173,62,0,0.10)] backdrop-blur-md">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.32em] text-[#a12e00]">Daftar Jadwal</p>
                <h2 class="display-font mt-3 text-[2rem] font-black leading-tight text-[#7a1200]">Operasional Per Tanggal</h2>
              </div>
              <p class="max-w-sm text-sm leading-7 text-[#8a2a08]">
                Kartu yang cocok dengan tanggal hari ini akan otomatis disorot.
              </p>
            </div>
          </div>
        </section>

        <section aria-labelledby="jadwal-list">
          <div class="grid gap-5 md:grid-cols-2 2xl:grid-cols-3">
            {
              schedule.map((item, index) => (
                <article
                  class:list={[
                    "rise-card relative overflow-hidden rounded-[2.1rem] border p-6 shadow-[0_20px_60px_rgba(173,62,0,0.10)] transition duration-300",
                    item.type === "closed"
                      ? "border-[#ff0000] bg-[linear-gradient(135deg,#ff0000_0%,#c60000_100%)] text-white md:col-span-2 2xl:col-span-3"
                      : item.type === "halfday"
                        ? "border-[#ffc300]/45 bg-[linear-gradient(135deg,#fff9eb_0%,#fff2d2_100%)]"
                        : item.type === "lebaran"
                          ? "border-[#ffc300]/35 bg-[linear-gradient(135deg,#fff3e7_0%,#fffdf8_100%)]"
                          : "border-white/70 bg-[linear-gradient(135deg,rgba(255,255,255,0.93)_0%,rgba(255,244,237,0.92)_100%)] backdrop-blur hover:-translate-y-1 hover:shadow-[0_24px_70px_rgba(173,62,0,0.12)]",
                  ]}
                  data-date={item.date}
                  style={`animation-delay: ${index * 70}ms;`}
                >
                  <div
                    aria-hidden="true"
                    class:list={[
                      "absolute inset-x-0 top-0 h-1.5",
                      item.type === "closed"
                        ? "bg-white/45"
                        : item.type === "halfday" || item.type === "lebaran"
                          ? "bg-[#ffc300]"
                          : "bg-[#ff0000]",
                    ]}
                  />

                  <div class="relative flex flex-col gap-6">
                    <div class="flex items-start justify-between gap-5">
                      <div class="flex items-start gap-4">
                        <div class:list={[
                          "flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-[1.5rem] shadow-[0_16px_36px_rgba(122,18,0,0.12)]",
                          item.type === "closed" ? "bg-white text-[#ff0000]" : "bg-[#7a1200] text-[#fff8f3]",
                        ]}>
                          <span class="display-font text-2xl font-black leading-none">{item.dayNumber}</span>
                          <span class="mt-1 text-[10px] font-black uppercase tracking-[0.28em]">Mar</span>
                        </div>

                        <div>
                          <p class:list={[
                            "text-xs font-black uppercase tracking-[0.28em]",
                            item.type === "closed" ? "text-white/75" : "text-[#a12e00]",
                          ]}>
                            {item.label}
                          </p>
                          <h3
                            id={item.date === schedule[0].date ? "jadwal-list" : undefined}
                            class:list={[
                              "display-font mt-3 text-[1.75rem] font-black leading-tight",
                              item.type === "closed" ? "text-white" : "text-[#7a1200]",
                            ]}
                          >
                            {item.title}
                          </h3>
                          <p class:list={[
                            "mt-3 text-sm font-semibold",
                            item.type === "closed" ? "text-white/85" : "text-[#8a2a08]",
                          ]}>
                            {item.displayDate}
                          </p>
                        </div>
                      </div>

                      <div class="flex flex-col items-end gap-2">
                        <span class:list={[
                          "rounded-full px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em]",
                          item.type === "closed" ? "bg-white text-[#ff0000]" : "bg-[#ffc300] text-[#7a1200]",
                        ]}>
                          {item.hours}
                        </span>
                        <span class:list={[
                          "today-chip hidden rounded-full border px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em]",
                          item.type === "closed"
                            ? "border-white/45 bg-white/15 text-white"
                            : "border-[#ff0000]/10 bg-white text-[#ff0000]",
                        ]}>
                          Hari Ini
                        </span>
                      </div>
                    </div>

                    <div class="flex flex-wrap gap-2.5">
                      <span class:list={[
                        "rounded-full px-3 py-1 text-xs font-black uppercase tracking-[0.2em]",
                        item.type === "closed" ? "bg-white/12 text-white" : "bg-[#7a1200] text-[#fff8f3]",
                      ]}>
                        {item.openCount} gerai buka
                      </span>
                      <span class:list={[
                        "rounded-full px-3 py-1 text-xs font-black uppercase tracking-[0.2em]",
                        item.type === "closed" ? "bg-white/12 text-white" : "bg-white text-[#a12e00]",
                      ]}>
                        {item.closedCount} gerai tutup
                      </span>
                    </div>

                    <p class:list={[
                      "text-sm leading-7",
                      item.type === "closed" ? "text-white/85" : "text-[#8a2a08]",
                    ]}>
                      {item.note}
                    </p>

                    {
                      item.type === "closed" ? (
                        <div class="rounded-[1.6rem] border border-white/20 bg-white/10 p-5">
                          <p class="text-xs font-black uppercase tracking-[0.24em] text-white/70">Gerai Terdampak</p>
                          <ul class="mt-4 flex flex-wrap gap-2.5">
                            {
                              item.closedBranches.map((branch) => (
                                <li class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-bold text-white">
                                  {branch}
                                </li>
                              ))
                            }
                          </ul>
                        </div>
                      ) : (
                        <div class="grid gap-4">
                          <div class="rounded-[1.6rem] border border-[#ff0000]/10 bg-white/80 p-5">
                            <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Gerai Buka</p>
                            <ul class="mt-4 flex flex-wrap gap-2.5">
                              {
                                item.openBranches.map((branch) => (
                                  <li class="rounded-full border border-[#ff0000]/10 bg-[#fff7f1] px-3 py-1 text-xs font-bold text-[#7a1200]">
                                    {branch}
                                  </li>
                                ))
                              }
                            </ul>
                          </div>

                          <div class="rounded-[1.6rem] border border-[#ff0000]/10 bg-white/70 p-5">
                            <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a12e00]">Gerai Tutup</p>
                            {
                              item.closedBranches.length > 0 ? (
                                <ul class="mt-4 flex flex-wrap gap-2.5">
                                  {
                                    item.closedBranches.map((branch) => (
                                      <li class="rounded-full border border-[#7a1200]/10 bg-white px-3 py-1 text-xs font-bold text-[#8a2a08]">
                                        {branch}
                                      </li>
                                    ))
                                  }
                                </ul>
                              ) : (
                                <p class="mt-4 text-sm font-semibold leading-7 text-[#7a1200]">
                                  Tidak ada. Semua gerai beroperasi normal.
                                </p>
                              )
                            }
                          </div>
                        </div>
                      )
                    }
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      </section>

      <section id="end-screen" class="hidden min-h-screen items-center justify-center py-8" aria-live="polite">
        <div class="w-full max-w-3xl rounded-[2.9rem] border border-white/70 bg-white/60 px-6 py-12 text-center shadow-[0_30px_100px_rgba(168,62,0,0.14)] backdrop-blur-md sm:px-12 sm:py-18">
          <img src="/logo.png" alt="Ayam Guling Enakko Logo" class="mx-auto h-20 mb-4" />
          <span class="inline-flex rounded-full bg-[#ffc300] px-4 py-1 text-xs font-black uppercase tracking-[0.24em] text-[#7a1200]">
            Coming Soon
          </span>
          <h2 class="display-font mt-6 text-[2.3rem] font-black leading-tight text-[#ff0000] sm:text-[3.6rem]">
            Terima Kasih, Operasional Telah Kembali Normal.
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-[#8a2a08] sm:text-lg">
            Nantikan promo kami selanjutnya. Jadwal khusus Nyepi & Lebaran 2026 sudah selesai dan seluruh gerai kembali beroperasi normal.
          </p>
        </div>
      </section>
    </main>

    <script id="schedule-data" type="application/json">{JSON.stringify(schedule)}</script>

    <script>
      const scheduleDataElement = document.getElementById("schedule-data");
      const statusShell = document.getElementById("status-shell");
      const statusBanner = document.getElementById("status-banner");
      const currentDateLabel = document.getElementById("current-date-label");
      const scheduleContent = document.getElementById("schedule-content");
      const endScreen = document.getElementById("end-screen");
      const cardElements = Array.from(document.querySelectorAll("[data-date]"));
      const scheduleItems = scheduleDataElement ? JSON.parse(scheduleDataElement.textContent || "[]") : [];

      const formatKey = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      };

      const today = new Date();
      const localToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());
      const todayKey = formatKey(localToday);
      const startDate = new Date(2026, 2, 16);
      const endDate = new Date(2026, 2, 25);

      currentDateLabel.textContent = new Intl.DateTimeFormat("id-ID", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      }).format(today);

      if (localToday > endDate) {
        scheduleContent.classList.add("hidden");
        endScreen.classList.remove("hidden");
        endScreen.classList.add("flex");
      } else {
        const todaySchedule = scheduleItems.find((item) => item.date === todayKey);

        const toneMap = {
          normal: ["border-white/12", "bg-white/10"],
          limited: ["border-white/12", "bg-white/10"],
          halfday: ["border-[#ffc300]/45", "bg-[rgba(255,195,0,0.16)]"],
          lebaran: ["border-[#ffc300]/40", "bg-[rgba(255,195,0,0.18)]"],
          closed: ["border-white/5", "bg-[#ff0000]"],
          default: ["border-white/12", "bg-white/10"],
        };

        const applyTone = (tone) => {
          const tones = toneMap[tone] || toneMap.default;
          statusShell.classList.remove(
            "border-white/12",
            "bg-white/10",
            "border-[#ffc300]/45",
            "bg-[rgba(255,195,0,0.16)]",
            "border-[#ffc300]/40",
            "bg-[rgba(255,195,0,0.18)]",
            "border-white/5",
            "bg-[#ff0000]"
          );
          statusShell.classList.add(...tones);
        };

        if (todaySchedule) {
          const prefix = "HARI INI:";
          statusBanner.textContent = `${prefix} ${todaySchedule.bannerMessage}`;
          applyTone(todaySchedule.type);
        } else if (localToday < startDate) {
          statusBanner.textContent = "Pengumuman ini berlaku mulai 16 Maret 2026. Seluruh detail operasional sudah tersedia di daftar jadwal di bawah.";
          applyTone("default");
        } else {
          statusBanner.textContent = "Periode operasional khusus tidak aktif pada tanggal ini. Silakan cek daftar jadwal untuk referensi lengkap.";
          applyTone("default");
        }

        cardElements.forEach((card) => {
          if (card.getAttribute("data-date") === todayKey) {
            card.classList.add("ring-4", "ring-[#ff0000]", "ring-offset-4", "ring-offset-[#ffe4d6]", "scale-[1.01]");
            const todayChip = card.querySelector(".today-chip");
            if (todayChip) {
              todayChip.classList.remove("hidden");
            }
          }
        });
      }
    </script>
  </body>
</html>
